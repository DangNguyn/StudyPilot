SUPABASE_URL=
SUPABASE_SECRET_KEY=
DEMO_USER_ID=
GROQ_API_KEY=
GEMINI_API_KEY=

# Claude dùng để phân tích tài liệu (lấy key tại https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Tuỳ chọn: claude-sonnet-5-5 (mặc định), claude-opus-5-5, claude-haiku-5-5
# Việc nặng (nhận diện chương, viết tóm tắt) và việc nhẹ lặp lại hằng ngày (câu hỏi, quiz, đánh giá, mindmap)
CLAUDE_MODEL_HEAVY=claude-sonnet-5-5
CLAUDE_MODEL_LIGHT=claude-haiku-5-5
# Tuỳ chọn: số bài được biên soạn song song (giảm nếu gặp lỗi 429)
CLAUDE_MAX_CONCURRENCY=4

# Thông báo học tập qua Gmail (xem hướng dẫn tạo Mật khẩu ứng dụng)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Địa chỉ frontend, dùng cho các nút trong thư
APP_URL=http://localhost:3000

# Gói tài khoản mặc định (free hoặc pro). Mindmap chỉ có ở gói pro
DEFAULT_PLAN=free
# Chỉ bật khi phát triển: cho phép bấm chuyển free/pro trên giao diện để thử
ALLOW_PLAN_SWITCH=false
